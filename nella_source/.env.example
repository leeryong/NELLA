# LLMOps Platform Configuration
# Copy this file to .env and fill in your values

# App
APP_NAME=LLMOps Platform
DEBUG=false
SECRET_KEY=your-secret-key-here

# Server
HOST=0.0.0.0
PORT=8000

# LLM Provider (openai, anthropic, ollama)
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1  # Optional for custom endpoints

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Ollama (local LLM)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# HuggingFace
# HF_TOKEN=hf_your-token-here  # Required for some models (Llama etc.)
# HF_CACHE_DIR=/path/to/hf-cache

# Training defaults
DEFAULT_TRAIN_RATIO=0.9
DEFAULT_EPOCHS=3
DEFAULT_LEARNING_RATE=0.0002
DEFAULT_BATCH_SIZE=4
DEFAULT_MAX_SEQ_LENGTH=2048
DEFAULT_LORA_RANK=16
DEFAULT_LORA_ALPHA=32

# AutoResearch
AUTORESEARCH_MAX_TRIALS=5
AUTORESEARCH_STEPS_PER_TRIAL=50

# CORS origins for frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Redis (optional, for Celery background tasks)
# REDIS_URL=redis://localhost:6379/0
